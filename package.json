{
  "name": "zylos-browser-extension",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:unit": "vitest run",
    "test:build": "npm run build && node --test tests/build.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && node tests/e2e/browser-actions.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "daisyui": "^5.7.38",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "description": "Coco browser executor — WXT + React. Connect to a zylos-browser-remote relay for side-panel chat and browser tasks."
}
